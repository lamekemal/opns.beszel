<model>
    <mount>//OPNsense/beszelagent</mount>
    <version>1.0.0</version>
    <description>Beszel Agent settings</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
                <ValidationMessage>Please select enable or disable.</ValidationMessage>
            </enabled>
            <huburl type="TextField">
                <Required>Y</Required>
                <Mask>/^(https?:\/\/).+$/</Mask>
                <ValidationMessage>Please enter a valid URL (e.g. http://192.168.1.50:8090).</ValidationMessage>
            </huburl>
            <listenport type="IntegerField">
                <Default>45876</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>65535</MaximumValue>
                <Required>Y</Required>
                <ValidationMessage>Please enter a valid port number (1-65535).</ValidationMessage>
            </listenport>
            <publickey type="TextField">
                <Required>Y</Required>
                <ValidationMessage>Please enter the SSH public key from the Beszel Hub.</ValidationMessage>
            </publickey>
            <token type="TextField">
                <Required>Y</Required>
                <ValidationMessage>Please enter the authentication token from the Beszel Hub.</ValidationMessage>
            </token>
            <extrafilesystems type="TextField">
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9\/,._-]*$/</Mask>
                <ValidationMessage>Please enter a comma-separated list of filesystem paths.</ValidationMessage>
            </extrafilesystems>
        </general>
    </items>
</model>
